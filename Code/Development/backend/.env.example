# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nexusmind

# ── Neo4j Knowledge Graph ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── LLM (Groq / OpenRouter) ───────────────────────────────
# Get free API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Get API key from https://openrouter.ai (Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct

LLM_PROVIDER=groq

# ── Storage ───────────────────────────────────────────────
UPLOADS_DIR=./uploads
REPORTS_DIR=./reports
UPLOAD_MAX_SIZE_MB=50

# ── ML Isolation Forest Hyperparameters ───────────────────
ML_CONTAMINATION=0.10
ML_RANDOM_STATE=42

# ── Preprocessing (Savitzky-Golay) ─────────────────────────
SG_WINDOW_LENGTH=5
SG_POLYORDER=2

# ── CORS Allowlist ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
