# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=nexusmind

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── LLM — model names are config, not code ────────────────
# llama-3.1-8b-instant is the current Groq production model
# Run GET https://api.groq.com/openai/v1/models to verify current catalog
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Fallback: llama-3.3-70b-versatile if summary quality is weak

# Verify current OpenRouter model at GET https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct

LLM_PROVIDER=groq           # groq | openrouter

# ── Storage ───────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
REPORTS_DIR=/app/reports
UPLOAD_MAX_SIZE_MB=50

# ── ML Hyperparameters — tunable without redeploy ─────────
ML_CONTAMINATION=0.1        # float 0.0–0.5 or "auto" — use 0.1 for small chromatography sets
ML_RANDOM_STATE=42

# ── Preprocessing ─────────────────────────────────────────
SG_WINDOW_LENGTH=5          # must be odd; guard shrinks if data < window
SG_POLYORDER=2

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# localhost:8080  = frontend served by Docker nginx (port 8080)
# localhost:5173  = Vite dev server (npm run dev, outside Docker)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Frontend Build ────────────────────────────────────────
# Baked into the JS bundle at 'docker-compose up --build' time via build.args.
# Override here to point the built frontend at a different backend.
VITE_API_URL=http://localhost:8000/api/v1
